<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the engine-free DeadLetter.Core sources straight out of the Unity project
    so they can be built and tested with plain `dotnet test` (no Unity editor needed).
    LangVersion 9.0 matches Unity 6's C# compiler, so anything that compiles here
    compiles in Unity too.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>DeadLetter.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../DeadLetter/Assets/DeadLetter/Core/**/*.cs" LinkBase="Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
